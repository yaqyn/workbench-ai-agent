#!/usr/bin/env bash
# Run from any directory; uv manages the project's Python environment.
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v uv >/dev/null 2>&1; then
    printf '%s\n' 'Error: uv is required. Install it from https://docs.astral.sh/uv/.' >&2
    exit 127
fi
exec uv run --locked --project "$project_dir" python "$project_dir/main.py" "$@"
